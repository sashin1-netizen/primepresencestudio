# PUBLIC PRODUCTION — required only after owner approval; never commit real secrets.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CANONICAL_DOMAIN=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_OG_IMAGE=
PUBLIC_LAUNCH_APPROVED=false

# PRIVATE PREVIEW — server flag controls noindex/robots/review routes.
PRIVATE_PREVIEW_ENABLED=false
PRIVATE_PREVIEW_INCLUDE_DRAFTS=false

# Compatibility/display hint only; never use a NEXT_PUBLIC variable as access control.
NEXT_PUBLIC_PREVIEW_MODE=false

# Optional credentials are for a hosting provider/proxy that implements authentication.
# This static application does not read or expose these values.
PRIVATE_PREVIEW_USERNAME=
PRIVATE_PREVIEW_PASSWORD=
